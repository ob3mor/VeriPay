# =============================================================================
# VeriPay — environment template
#
# Copy to `.env` at the repo root and adjust. `.env` is gitignored — NEVER
# commit real secrets. Values below are dev-safe defaults for the no-Docker
# local profile (docs/ARCHITECTURE.md §6 configuration matrix).
#
# Naming contract: the backend reads pydantic-settings with the VERIPAY_
# prefix (apps/api/app/core/config.py). The storage_s3_* fields accept BOTH
# dialects via validation aliases: the canonical VERIPAY_STORAGE_S3_* names
# below, and the older VERIPAY_MINIO_* names used by
# infrastructure/local/docker-compose.yml. VERIPAY_MINIO_SECURE has no
# counterpart by design — the endpoint URL already carries the scheme.
# =============================================================================

# --- Runtime environment (backend) -------------------------------------------
# development | test | production (case-insensitive; "prod" normalizes).
# In production the app refuses to start without a strong VERIPAY_JWT_SECRET.
VERIPAY_ENV=development

# --- Database (backend) ------------------------------------------------------
# No-Docker local default: SQLite (ADR 0002 fallback; tests also use SQLite).
VERIPAY_DATABASE_URL=sqlite:///./veripay.db
# PROFILE A (docker compose up): switch to PostgreSQL —
# VERIPAY_DATABASE_URL=postgresql+psycopg://veripay:veripay_dev@localhost:5432/veripay

# --- Auth (backend) ----------------------------------------------------------
# HS256 signing secret. MUST be overridden with a real random value outside
# local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
VERIPAY_JWT_SECRET=dev-only-insecure-secret-change-me
VERIPAY_JWT_ALGORITHM=HS256
# Short-lived Bearer token for programmatic clients (minutes). Browser
# sessions use the httpOnly cookie below and POST /auth/refresh.
VERIPAY_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Durable cookie session lifetime (days) — no tokens in web storage.
VERIPAY_SESSION_TTL_DAYS=7
# True only behind HTTPS (PROFILE B); local dev over http keeps False.
VERIPAY_COOKIE_SECURE=false

# --- Storage (backend) -------------------------------------------------------
# StorageProvider seam (ARCHITECTURE §7.1): local | minio.
# Default here is the no-Docker local filesystem; PROFILE A compose sets minio.
VERIPAY_STORAGE_BACKEND=local
# Root for the local filesystem provider (gitignored via data/).
VERIPAY_STORAGE_LOCAL_ROOT=./data/documents

# --- S3/MinIO (backend; used when VERIPAY_STORAGE_BACKEND=minio) -------------
# Defaults match the minio service in infrastructure/local/docker-compose.yml.
# On the host (this file) MinIO is reachable via localhost; inside compose the
# API uses http://minio:9000 instead. The legacy VERIPAY_MINIO_* names are
# accepted as aliases of these (config.py AliasChoices).
VERIPAY_STORAGE_S3_ENDPOINT_URL=http://localhost:9000
VERIPAY_STORAGE_S3_ACCESS_KEY_ID=veripay
VERIPAY_STORAGE_S3_SECRET_ACCESS_KEY=veripay-dev-change-me
VERIPAY_STORAGE_S3_BUCKET=veripay-documents
# Optional (S3 region); leave unset for local MinIO.
# VERIPAY_STORAGE_S3_REGION=

# --- OCR (backend) -----------------------------------------------------------
# OcrProvider seam (ARCHITECTURE §7.2): "text_layer" (default — reads the
# embedded digital text of PDFs via pypdf) | "tesseract" (local pixel OCR;
# optional [ocr] extra + system binary) | "azure" (Azure Document
# Intelligence; optional [azure-ocr] extra) | "stub" (deterministic
# placeholder). An unavailable engine falls back to the stub with an explicit,
# persisted reason — never silently.
VERIPAY_OCR_PROVIDER=text_layer
# R3 confidence gate: machine-extracted values at/above this threshold may be
# used as evidence; below (or NULL) they emit unverified_input instead.
VERIPAY_OCR_CONFIDENCE_THRESHOLD=0.85
# Tesseract language packs (used when VERIPAY_OCR_PROVIDER=tesseract).
VERIPAY_TESSERACT_LANG=ara+eng

# --- Azure Document Intelligence (only when VERIPAY_OCR_PROVIDER=azure) ------
# CREDENTIALS: leave unset here and inject real values from a secret store —
# NEVER commit them. F0 free-tier contract: at most VERIPAY_AZURE_DI_PAGE_CAP
# pages per document are analyzed; the cap is honored, never raised by code.
# VERIPAY_AZURE_DI_ENDPOINT=
# VERIPAY_AZURE_DI_KEY=
# VERIPAY_AZURE_DI_MODEL=prebuilt-invoice
# VERIPAY_AZURE_DI_PAGE_CAP=2
# VERIPAY_AZURE_DI_TIMEOUT_SECONDS=30
# VERIPAY_AZURE_DI_MAX_RETRIES=3

# --- Processing (backend) ----------------------------------------------------
# ProcessingBackend seam: "inline" (default — executes jobs synchronously in
# the request; no worker needed, keeps the Azure demo scale-to-zero) or
# "celery" (optional PROFILE A worker over Redis; see compose worker profile).
VERIPAY_PROCESSING_BACKEND=inline

# --- Uploads (backend) -------------------------------------------------------
# Hard ceiling for document uploads (PDF/PNG/JPEG only, magic-byte checked).
VERIPAY_UPLOAD_MAX_BYTES=10485760

# --- API surface -------------------------------------------------------------
# Comma-separated CORS allowlist (API.md §1 — wildcards are rejected in review).
VERIPAY_CORS_ORIGINS=http://localhost:3000

# --- Auth throttling (backend, app/core/ratelimit.py) ------------------------
# Sliding-window limits per client IP, plus a failed-login lockout per
# (IP, email) pair.
VERIPAY_RATE_LIMIT_LOGIN_PER_MINUTE=20
VERIPAY_RATE_LIMIT_REGISTER_PER_MINUTE=10
VERIPAY_LOGIN_LOCKOUT_MAX_FAILURES=5
VERIPAY_LOGIN_LOCKOUT_WINDOW_SECONDS=900

# --- Background worker (optional 'worker' compose profile) -------------------
VERIPAY_REDIS_URL=redis://localhost:6379/0

# --- Web (frontend, apps/web) ------------------------------------------------
# Base URL of the REST API; build-time env for the static export (PROFILE B).
# apps/web/src/lib/api.ts accepts the origin with or without the /api/v1
# suffix and normalizes both (see apps/web/.env.example).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
