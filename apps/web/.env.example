# =============================================================================
# VeriPay web (@veripay/web) — environment template
#
# Copy to .env.local (gitignored at the repo root) and adjust. NOTHING here is
# required at build time: with no env file at all, `next build` produces the
# static export and src/lib/api.ts falls back to http://localhost:8000.
# =============================================================================

# --- API base URL (build-time inlined into the client bundle) ---------------
# Origin of the VeriPay REST API (docs/API.md §1: every endpoint lives under
# /api/v1). src/lib/api.ts normalizes BOTH forms below to the same result —
# it never double-appends the /api/v1 prefix:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1   (root .env.example form)
#
# For Azure Static Web Apps, set this to the deployed API origin and rebuild —
# it is baked in at build time, not read at runtime.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
